# Database
# Note: When running in Docker, use 'pgbouncer' hostname and port 6432 with pgbouncer=true
DATABASE_URL="postgresql://fileshare_user:your_password@pgbouncer:6432/fileshare?pgbouncer=true"

# NextAuth
AUTH_SECRET="generate-a-random-32-char-string-here"
AUTH_URL="http://localhost:3000"

# Biznet Gio NEO Object Storage (S3 Compatible)
S3_ENDPOINT="https://s3.biznetgio.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY="your_biznet_access_key"
S3_SECRET_KEY="your_biznet_secret_key"
S3_BUCKET="file-sharing-prod"

# App Config
NEXT_PUBLIC_APP_NAME="File Sharing Platform"
NEXT_PUBLIC_MAX_FILE_SIZE=5368709120
